{
	"name": "redundant",
	"private": true,
	"packageManager": "pnpm@9.4.0",
	"scripts": {
		"dev": "turbo run dev --parallel",
		"build": "turbo run build --filter=@redundant/common --filter=@redundant/transactional --filter=backend",
		"build:common": "cd packages/common && pnpm build",
		"start": "cd packages/backend && pnpm start:prod"
	},
	"devDependencies": {
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"prettier": "^3.0.0",
		"turbo": "^2.1.3"
	}
}
