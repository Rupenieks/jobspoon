// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  fullName  String
  googleId  String?  @unique
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  resumes   Resume[]
}

model Resume {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  data          Json     // This will store all resume data
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Virtual fields for querying
  matches       Match[]  @relation("ResumeToMatch")
  applications  Application[] 

  @@index([userId])
}

model Match {
  id              String   @id @default(uuid())
  resumeId        String
  resume          Resume   @relation("ResumeToMatch", fields: [resumeId], references: [id], onDelete: Cascade)
  integrationId   String
  companyName     String?
  companyUrl      String?
  seniority       String?
  positionTitle   String
  description     String?
  longDescription String?
  country         String
  city            String
  applyUrl        String?
  domain          String?
  longitude       Float?
  latitude        Float?
  provider        String
  datePosted      String?
  hybrid          Boolean?
  remote          Boolean?
  salary          String?
  reposted        Boolean?
  dateReposted    String?
  hiringTeam      Json?    // Stored as JSON array
  company         Json?    // Stored as JSON object
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  // Virtual field for querying
  application     Application?

  @@unique([resumeId, integrationId])
  @@index([resumeId])
}

model Application {
  id        String   @id @default(uuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resumeId, matchId])
  @@index([resumeId])
  @@index([matchId])
}
