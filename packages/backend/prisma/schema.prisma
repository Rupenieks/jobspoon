// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String?
  fullName  String
  googleId  String?  @unique
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isOnboarded Boolean @default(false)
  country   String?
  city            String?
  seekingRemote   Boolean?
  desiredJobTitles String[]
  resumes         Resume[]
  matches         Match[]
  applications    Application[]

  jobMatchRuns    JobMatchRun[]
}

model Resume {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  data          Json     // This will store all resume data
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matchId       String?
  applicationId String?
  
  // Virtual fields for querying
  matches       Match[]  @relation("ResumeToMatch")
  applications  Application[]
  jobMatchRuns   JobMatchRun[]

  @@index([userId])
}

model Match {
  id              String   @id @default(uuid())
  resumeId        String
  resume          Resume   @relation("ResumeToMatch", fields: [resumeId], references: [id], onDelete: Cascade)
  integrationId   String
  companyName     String?
  companyUrl      String?
  seniority       String?
  positionTitle   String
  description     String?
  longDescription String?
  country         String
  city            String
  applyUrl        String?
  domain          String?
  longitude       Float?
  latitude        Float?
  provider        String
  datePosted      String?
  hybrid          Boolean?
  remote          Boolean?
  salary          String?
  reposted        Boolean?
  dateReposted    String?
  hiringTeam      Json?    // Stored as JSON array
  company         Json?    // Stored as JSON object
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  userId          String
  
  // Virtual field for querying
  application     Application?
  user            User     @relation(fields: [userId], references: [id])
  jobMatchRun     JobMatchRun? @relation(fields: [jobMatchRunId], references: [id])
  jobMatchRunId   String?

  @@unique([resumeId, integrationId])
  @@index([resumeId])
  @@index([jobMatchRunId])
}

model Application {
  id        String   @id @default(uuid())
  resumeId  String
  resume    Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  stage     String   @default("not_applied")
  notes     String?

  insights  Insight[]
  insightGenerationRequests ApplicationInsightGenerationRequest[]

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([resumeId, matchId])
  @@index([resumeId])
  @@index([matchId])
}

model Insight {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stage         String      
  data          Json?      
  hidden        Boolean      @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([applicationId])
}

model ApplicationInsightGenerationRequest {
  id                String      @id @default(uuid())
  applicationId     String
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumeId          String // audit field
  matchId           String // audit field
  applicationStage  String
  status           String      @default("STARTED")
  generatedInsightId String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([applicationId])
}

model JobMatchRun {
  id        String   @id @default(cuid())
  userId    String
  resumeId  String
  matches   Match[]
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resumeId])
  @@index([createdAt])
}
